# ==============================================================================
# CẤU HÌNH CON BIÊN (STANDALONE EDGE DEVICE)
# File: .env (Copy từ file này: cp .env.example .env)
# ==============================================================================

# 1. File cấu hình riêng của camera trên con biên này (mặc định: ./camera_config.yaml)
CONFIG_FILE=./camera_config.yaml

# 2. Nguồn camera: Khuyên dùng khai báo trực tiếp trong camera_config.yaml (trường 'source: ...')
# Nếu khai báo tại đây, biến này sẽ ghi đè trường source trong file YAML.
# CAM_SOURCE=assets/speed1.mp4
# CAM_SOURCE=rtsp://admin:Password123@192.168.1.100:554/Streaming/Channels/101

# 3. (Tùy chọn) Tự động ghép link RTSP từ thông tin camera
# IP_CAMERA=192.168.1.100:554
# TK_CAMERA=admin
# PASSWORD_CAMERA=Password123
# EXTEND_RSTP_LINK=/Streaming/Channels/101

# 4. Tùy chọn tối ưu hóa hiệu năng phần cứng Edge (Mặc định đọc từ camera_config.yaml)
# IMGSZ=480           # 480: Tăng ~2x FPS trên CPU biên yếu; 640: Độ nét chuẩn
# DEBUG_RULES=false   # Bật true nếu muốn xem log explain() phân tích xe
# LOG_LEVEL=INFO
