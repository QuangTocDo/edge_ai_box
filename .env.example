# Mau env cho docker compose hoac chay truc tiep (copy thanh .env, KHONG commit file .env).
# Uu tien secrets file cho thong tin nhay cam (mount vao /run/secrets/*).

# -------------------------------------------------------------
# 1. CAU HINH NGUON CAMERA (INPUT)
# -------------------------------------------------------------
# Cach 1: Test file video offline (hien tai dang test):
CAM_SOURCE=assets/video.mp4

# Cach 2: Trien khai truc tiep qua URL day du:
# CAM_SOURCE=rtsp://admin:123456@192.168.1.100:554/MediaInput/h264/stream_1

# Cach 3: Trien khai production theo bien he thong (tu dong ghep rtsp://...):
# IP_CAMERA=192.168.1.100
# TK_CAMERA=admin
# PASSWORD_CAMERA=admin12345
# EXTEND_RSTP_LINK=/MediaInput/h264/stream_1

LOG_LEVEL=INFO
